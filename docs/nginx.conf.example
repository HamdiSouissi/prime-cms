# Prime CMS — Exemple de configuration Nginx
# Document root impérativement positionné sur `public/`.

server {
    listen 80;
    listen [::]:80;
    server_name example.com;

    root /var/www/prime-cms/public;
    index index.php;

    charset utf-8;
    client_max_body_size 32M;

    # Bloquer l'accès aux fichiers cachés (.env, .htaccess, .git...)
    location ~ /\.(?!well-known).* {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Cache long terme sur les assets statiques versionnés (?v=mtime)
    location ~* ^/assets/.*\.(css|js|svg|png|jpg|jpeg|webp|woff2|ico)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Médiathèque (/uploads/) — service statique direct depuis content/uploads/ sans jamais exécuter PHP
    # (`php bin/prime media:link` crée le lien symbolique public/uploads -> ../content/uploads)
    location ^~ /uploads/ {
        # Interdire tout fichier exécutable, script ou HTML/SVG dans /uploads/
        location ~* \.(php|php[3-8]|phtml|phar|phps|pht|shtml|cgi|pl|py|rb|sh|exe|svg|svgz|html|htm|xhtml)$ {
            return 403;
        }

        # Forcer le téléchargement (attachment) pour les documents bureautiques, archives et textes
        location ~* \.(zip|docx|xlsx|pptx|odt|ods|txt|csv)$ {
            add_header X-Content-Type-Options "nosniff" always;
            add_header Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; style-src 'unsafe-inline'; sandbox" always;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            add_header Content-Disposition "attachment" always;
            try_files $uri /index.php?$query_string;
        }

        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; style-src 'unsafe-inline'; sandbox" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        expires 1y;
        try_files $uri /index.php?$query_string;
    }

    # Front controller unique
    location / {
        try_files $uri /index.php?$query_string;
    }

    # Exécution PHP uniquement via index.php
    location ~ ^/index\.php(/|$) {
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        internal;
    }

    # Interdire l'exécution de tout autre fichier PHP exposé
    location ~ \.php$ {
        return 404;
    }
}
