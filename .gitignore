# Composer (dev tools only)
/vendor/

# Environment
/.env
/.env.local
/.env.*.local

# Runtime storage (preserve directory structure via .gitkeep)
/storage/*
!/storage/.gitkeep
!/storage/cache/
/storage/cache/*
!/storage/cache/.gitkeep
!/storage/logs/
/storage/logs/*
!/storage/logs/.gitkeep
!/storage/sessions/
/storage/sessions/*
!/storage/sessions/.gitkeep
!/storage/plugins/
/storage/plugins/*
!/storage/plugins/.gitkeep
!/storage/themes/
/storage/themes/*
!/storage/themes/.gitkeep
!/storage/tmp/
/storage/tmp/*
!/storage/tmp/.gitkeep

# Published plugin & theme static assets and generated site favicons
/public/assets/plugins/*
!/public/assets/plugins/.gitkeep
/public/assets/themes/*
!/public/assets/themes/.gitkeep
/public/assets/site/*
!/public/assets/site/.gitkeep

# User uploads & public symlink
/content/uploads/*
!/content/uploads/.gitkeep
/public/uploads

# Quality tool caches
/.phpunit.cache/
/.php-cs-fixer.cache
/.phpstan-cache/

# IDEs & Editors
/.idea/
/.vscode/
*.swp
*.swo
*~

# OS artifacts
.DS_Store
Thumbs.db
Desktop.ini

# Local dev harness (PHP/Composer unavailable in this sandbox)
/.arena-tools/

# Local demo runtime (generated database, cache and logs)
/storage-demo/
