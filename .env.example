# -----------------------------------------------------------------------------
# Prime CMS — Configuration d'environnement (exemple)
# Copier ce fichier en `.env` et adapter les valeurs à votre environnement.
# L'assistant d'installation web (`/install`) ou `php bin/prime install` génère
# automatiquement ce fichier avec une clé `APP_KEY` aléatoire.
# Ne jamais commiter le fichier `.env`.
# -----------------------------------------------------------------------------

# Identité de l'application
APP_NAME="Prime CMS"

# Clé applicative (256 bits en base64, générée par l'installateur)
APP_KEY=

# Environnement d'exécution : local | production
APP_ENV=local

# Affichage de la page d'erreur détaillée (false impératif en production)
APP_DEBUG=true

# URL publique du site (sans slash final)
APP_URL=http://localhost:8080

# Fuseau horaire PHP (ex. Europe/Paris, UTC)
APP_TIMEZONE=Europe/Paris

# Langue par défaut (fr, en, it)
APP_LOCALE=fr

# Niveau minimal des logs : debug | info | notice | warning | error | critical | alert | emergency
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Base de données (MySQL 8.0+ / MariaDB 10.6+)
# Valeurs par défaut alignées sur `docker-compose.yml`
# -----------------------------------------------------------------------------
DB_HOST=db
DB_PORT=3306
DB_DATABASE=prime_cms
DB_USERNAME=prime
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
DB_PREFIX=pc_
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# -----------------------------------------------------------------------------
# Messagerie (e-mails de réinitialisation, invitations et alertes sécurité)
# Pilotes pris en charge : log (par défaut, écrit dans storage/logs/mail-*.log) | native (mail())
# -----------------------------------------------------------------------------
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@prime-cms.local
MAIL_FROM_NAME="Prime CMS"

# -----------------------------------------------------------------------------
# Système de plugins (Phase 5)
# -----------------------------------------------------------------------------
# Désactive le chargement de tous les plugins au démarrage (récupération d'urgence)
PRIME_SAFE_MODE=false

# Autorise ou interdit le téléversement d'archives ZIP depuis /admin/plugins
PLUGINS_ALLOW_UPLOAD=true

# Taille maximale d'une archive ZIP de plugin en mégaoctets
PLUGINS_MAX_UPLOAD_MB=20

# -----------------------------------------------------------------------------
# Gestion des contenus (Phase 6)
# -----------------------------------------------------------------------------
# Nombre maximal de révisions conservées par contenu (hors autosauvegardes)
CONTENT_REVISIONS_MAX=25

